-- Peeknext configuration
--
-- Settings in this file override built-in defaults.
-- Remove or comment a setting to use the current default.
--
-- Documentation:
-- https://peeknext.com/docs/
--
-- Default configuration:
-- https://github.com/peeknext/peeknext/blob/main/.hackerman
--
-- Default scripts:
-- https://github.com/peeknext/peeknext/blob/main/.hackerman-scripts
--
-- EULA:
-- https://peeknext.com/end-user-license-agreement/
--
-- Privacy:
-- https://peeknext.com/privacy-policy/

[license]

-- Peeknext is free for non-commercial use.
-- For commercial use, purchase a license: https://peeknext.com/pricing/

path_to_license_file                -- path to license file, /path/to/license.json


[editor]

-- Fonts: Use any installed font, or add fonts to:
-- ~/Library/Application Support/Peeknext/fonts
--
-- Bundled themes:
-- peeknext-dark,       peeknext-light,         peeknext-mono,
-- peeknext-contrast,   peeknext-midnight,      peeknext-paper,
-- sublime-monokai,     github-dark-dimmed,     github-light,
-- one-dark-pro,        catppuccin-mocha,       tokyo-night,
-- gruvbox-dark,        solarized-light,        ayu-mirage
--
-- Additional themes: https://github.com/peeknext/peeknext/tree/main/themes
-- Install themes in ~/Library/Application Support/Peeknext/themes

font                                SF Mono
font_weight                         -- light, normal, medium, bold, leave empty for default: normal on light mode and light on dark mode.
font_size                           14

line_extra_height                   2
tab_width                           4

theme                               peeknext-dark
adaptive_theme                      peeknext-light, peeknext-dark -- set theme to "adaptive" to use

auto_indent                         true
auto_complete                       true

file_explorer_root                  -- absolute path to folder to set as root on startup, default is Desktop
file_types_to_exclude               .dmg, .app, .git, .ttf, .dylib, .so, .venv, .pyc, .zip, .egg, .DS_Store, dist, build

files_to_open_on_startup            -- list of absolute paths to files to open on startup, e.g. todo.org, notes.txt, work.py

inline_command_in_files             txt, md, org,
inline_shell_symbol                 %
inline_chat_symbol                  >

bookmark_prefix                     !>
annotation_words                    TODO, NOTE, MARK, FIXME -- list of words used by navigator panel

scripts_enabled                     false
allow_unsafe_scripts                false -- allow imports

click_on_links                      false -- if false, use inline_command to activate

-- these bindings are additive, so does not override existing bindings
accept_auto_completion              -- tab, newline, move_caret_line_end (default is newline)
accept_code_completion              -- tab, newline, move_caret_line_end (default is tab)

-- ui

show_line_numbers                   true
show_scrollbar                      true
show_minimap                        false
show_indent_guides                  true
show_annotations                    true
show_ui_borders                     false
show_splitter_handle                false

-- cursor

cursor_width                        2
cursor_extra_height                 8

cursor_as_block                     false
cursor_line_highlight               true

cursor_blink                        false
cursor_blink_period                 530 -- 530 is default

cursor_trail_effect                 false

-- statusbar

show_line_info                      true
-- show_word_count                     false
show_file_explorer_root             true
show_file_with_path                 false
show_model_info                     true
show_active_lexer                   true

-- show_debug_info                     false

-- misc

ui_font                             SF Mono
ui_font_weight                      -- leave empty for default, normal
ui_font_size                        -- leave empty for default, 12pt

scrollbar_width                     4
minimap_width                       64

open_on_largest_screen              true
 
eol_mode                            lf -- crlf, cr, lf
eol_symbols_visible                 false

terminal_to_use                     -- Ghostty, Warp, default is Terminal

window_opacity                      1
selection_opacity                   0.2
indent_guides_opacity               0.1
whitespace_opacity                  0.1

-- unsaved_symbol                      *
whitespace_symbol                   ▪

vertical_rulers                     -- list of columns

-- experimental

switch_tab_on_cmd_scroll            true
hide_ui_on_type                     false
-- always_show_completion_list         true
-- wrap_word                           txt, md, 
tabs_over_spaces                    false
font_ligatures                      false -- requires restart
path_to_scripts_file                -- path to external scripts file, requires restart
-- use_native_title_bar                false
-- dim_non_active_editors              false
-- fixed_line_number_width             false
-- path_to_shell                       /bin/zsh -- not in use

[models]

-- Optional AI features powered by Ollama.
-- Set a model name to enable code completion or inline chat.
-- Models can run locally or through Ollama Cloud.
--
-- Code completion: https://peeknext.com/docs/#code-completion
-- Inline chat: https://peeknext.com/docs/#inline-chat

-- code_completion                     qwen2.5-coder:1.5b
-- inline_chat                         glm-5.3-flash:cloud

[keybinds]

-- Customize keyboard shortcuts by assigning key combinations to commands.
-- Use Cmd, Ctrl, Alt, and Shift as modifiers, joined with +.
-- Use Comma, Period, Plus, and Minus for the symbols , . + -
-- Leave a binding empty to disable its shortcut.
--
-- Editor commands: https://peeknext.com/docs/#editor-commands
-- Default keybindings: https://github.com/peeknext/peeknext/blob/main/.hackerman

new_file                            Cmd + N
new_window                          Cmd + Shift + N
open_file                           Cmd + O
save_file                           Cmd + S
save_file_as                        Cmd + Shift + S
save_file_copy_as
close_file                          Cmd + W
close_window                        Cmd + Shift + W
close_other_files
reopen_last_closed_file             Cmd + Shift + T
reload_from_disk                    Cmd + R

fold_line                           Cmd + L
fold_all                            Cmd + Shift + L

-- code_completion                     Option + Return
submit_prompt

line_comment                        Cmd + /
zoom_in                             Cmd + =,                Cmd + Plus
zoom_out                            Cmd + _,                Cmd + Minus
toggle_split_editor                 Cmd + \
show_file_explorer                  Cmd + P
show_outline_panel                  Cmd + I
show_buffer_explorer                Cmd + B,                Cmd + Shift + \
show_command_palette                Cmd + Shift + P
-- open_terminal_at_file
open_terminal                       Cmd + T
open_config_file                    Cmd + Comma
open_scripts_file                   Cmd + Shift + Comma
reveal_in_finder

select_all                          Cmd + A
undo                                Cmd + Z,                Control + /
redo                                Cmd + Shift + Z,        Control + Shift + /
lowercase                           Option + L
uppercase                           Option + U
cancel                              Escape,                 Control + G
newline                             Return,                 Cmd + Return,           Control + J
tab                                 Tab
backtab                             Shift + Tab
center_on_cursor                    Control + L
line_indent                         Cmd + ]
line_unindent                       Cmd + [
selection_duplicate
move_line_up
move_line_down
select_next_match                   Cmd + E
unselect_last_match                 Cmd + Shift + E
insert_line_below                   Shift + Return
insert_line_above

open_file_in_new_window
copy_path_to_file                   Cmd + Shift + C
reset_window_position
reset_file_explorer
reload_file_explorer
toggle_read_only
-- toggle_newspaper_scroll
select_matches                      Cmd + Option + F
add_cursors_to_line_starts
show_license_info
open_diff_from_git
open_diff_from_buffers
diff_open_buffers_word_indicators
go_to_line                          Cmd + G
-- tear_off_buffer
reset_zoom                          Cmd + 0
replace_all_eol
replace_tabs_with_spaces
toggle_indent_guides
sort_selected_lines
sort_selected_lines_reverse
toggle_word_wrap
unselect_other_active_tabs          Cmd + Escape
format_csv_columns

move_caret_to_fold_above            Option + Up
move_caret_to_fold_below            Option + Down

extend_selection_to_fold_above
extend_selection_to_fold_below

move_up_to_empty_line
move_up_to_empty_line_extend

move_down_to_empty_line
move_down_to_empty_line_extend

-- accept_first_completion_item
-- show_completion_list                Cmd + '

detach_lexer
auto_detect_lexer

detect_tab_width
tab_width_2_spaces
tab_width_4_spaces
tab_width_8_spaces

indent_with_spaces
indent_with_tabs

toggle_eol_symbols
replace_all_eol
eol_mode_lf
eol_mode_crlf
eol_mode_cr

find_in_file                        Cmd + F
show_search_explorer                Cmd + Shift + F

python_eval_line                    Cmd + Option + E

-- this is used to execute org-mode code, run shell commands, and evaluate expressions
inline_command                      Cmd + Shift + Return

-- Native MacOS keys bindings for document are rebound to para by default due to misclick prone
document_start                      Option + Comma
document_start_extend               Option + Shift + Comma
document_end                        Option + Period
document_end_extend                 Option + Shift + Period

home
home_extend

move_caret_back                     Left,                   Control + B
move_caret_forward                  Right,                  Control + F

extend_selection_back               Shift + Left,           Control + Shift + B
extend_selection_forward            Shift + Right,          Control + Shift + F

line_up                             Up,                     Control + P
line_up_extend                      Shift + Up,             Control + Shift + P
line_down                           Down,                   Control + N
line_down_extend                    Shift + Down,           Control + Shift + N

line_up_start
line_up_start_extend

line_down_end
line_down_end_extend

move_caret_line_start               Cmd + Left,             Control + A
move_caret_line_end                 Cmd + Right,            Control + E

extend_selection_line_start         Cmd + Shift + Left,     Control + Shift + A
extend_selection_line_end           Cmd + Shift + Right,    Control + Shift + E

line_scroll_up                      Control + Up
line_scroll_down                    Control + Down
line_add_caret_up                   Control + Shift + Up
line_add_caret_down                 Control + Shift + Down

duplicate_line                      Cmd + Shift + D
-- transpose_line

copy                                Cmd + C
cut                                 Cmd + X
paste                               Cmd + V

move_caret_paragraph_above          Cmd + Up,            Option + A
move_caret_paragraph_below          Cmd + Down,          Option + E

extend_selection_paragraph_above    Cmd + Shift + Up,    Option + Shift + A
extend_selection_paragraph_below    Cmd + Shift + Down,  Option + Shift + E

move_caret_back_word                Option + Left,          Option + B
move_caret_forward_word

extend_selection_back_word          Option + Shift + Left,  Option + Shift + B
extend_selection_forward_word

move_caret_back_word_end
move_caret_forward_word_end         Option + Right,         Option + F

extend_selection_back_word_end
extend_selection_forward_word_end   Option + Shift + Right, Option + Shift + F

move_caret_back_word_part           Control + Left
move_caret_forward_word_part        Control + Right

extend_selection_back_word_part     Control + Shift + Left
extend_selection_forward_word_part  Control + Shift + Right

page_up                             Option + V
page_down                           Control + V

-- extend_selection_page_up            Option + Shift + V
-- extend_selection_page_down          Control + Shift + V

page_up_stuttered
page_down_stuttered

-- stuttered_page_up_extend
-- stuttered_page_down_extend

delete_back                         Backspace
delete_back_not_newline             Shift + Backspace
delete_forward                      Cmd + D,                Control + D

delete_back_word                    Option + Backspace,     Control + Backspace
delete_forward_word                 Option + D

delete_line                         Cmd + Shift + K
delete_to_line_start                Cmd + Backspace,        Control + Shift + Backspace
delete_to_line_end                  Control + K

-- delete_to_blank_line_above          Option + Shift + K
-- delete_to_blank_line_below          Option + K

-- pane navigation
previous_tab                        Cmd + ;, Option + Cmd + Left
previous_tab_extend                 Cmd + Shift + ;, Option + Shift + Cmd + Left
next_tab                            Cmd + ', Option + Cmd + Right
next_tab_extend                     Cmd + Shift + ', Option + Shift + Cmd + Right

focus_main_editor
focus_split_editor

-- quick switch to buffer
switch_to_buffer_1                  Cmd + 1
switch_to_buffer_2                  Cmd + 2
switch_to_buffer_3                  Cmd + 3
switch_to_buffer_4                  Cmd + 4
switch_to_buffer_5                  Cmd + 5
switch_to_buffer_6                  Cmd + 6
switch_to_buffer_7                  Cmd + 7
switch_to_buffer_8                  Cmd + 8
switch_to_buffer_9                  Cmd + 9

extend_to_buffer_1
extend_to_buffer_2
extend_to_buffer_3
extend_to_buffer_4
extend_to_buffer_5
extend_to_buffer_6
extend_to_buffer_7
extend_to_buffer_8
extend_to_buffer_9


[user]

-- Assign keyboard shortcuts to custom Python functions.
-- Define functions in the scripts file and bind them here.
--
-- API reference: https://peeknext.com/api/

-- word_count                       Cmd + J


-- Themes:
-- https://peeknext.com/docs/#themes

-- background                   (editor background)
-- foreground                   (editor foreground)
-- text_color                   (highlighted text color)
-- cursor                       (cursor color)

-- default                      (default syntax color)
-- keyword                      (keyword syntax color)
-- class                        (class syntax color)
-- name                         (function name syntax color)
-- function                     (fucntion def syntax color)
-- string                       (string syntax color)
-- number                       (number syntax color)
-- operator                     (operator syntax color)
-- comment                      (comment syntax color)
-- special                      (special syntax color, used in some lexers to mark some syntax, eg. self, src, href)
-- type                         (type syntax color)
-- constant                     (constant syntax color)
-- builtin                      (builtin function syntax color)

-- _error                       (used in diffs)
-- _warning                     (used in diffs, warnings in status bar)
-- _success                     (used in diffs)

-- _selection                   (optional style for selections, fallback to cursor color)
-- _bold                        (optional style for bold rich text syntax, fallback to builtin)
-- _italic                      (optional style for italic rich text syntax, fallback to function name)
-- _underline                   (optional style for underline rich text syntax, fallback to default)
-- _verbatim                    (optional style for verbatim rich text syntax, fallback to function name)
-- _strike                      (optional style for strike rich text syntax, fallback to comment)
-- _code                        (optional style for inline code in markdown and org, fallback to comment)
-- _link                        (optional style for links in markdown and org, fallback to special)
-- _todo                        (optional style for todo syntax, fallback to cursor color)
-- _annotation                  (optional style for editor annotations, fallback to comment)

-- valid style formats:
-- #292929                      (text color)
-- #292929, bold                (text color, modification)
-- #9ECEF5, #9ECEF5             (text color, background color)
-- #9ECEF5, #9ECEF5, italic     (text color, background color, modification)

-- bundled peeknext themes

